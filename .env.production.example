# =================================================================
# VIBECRAFT Production Environment Configuration (.env.production.example)
# Use for bare-metal or VM production deployments
# =================================================================

# Server Port & Mode
PORT=5000
NODE_ENV=production

# MongoDB Production Connection (Replica Set / Atlas / Managed)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_code_reviewer?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ai_code_reviewer

# JWT Security
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_strong_cryptographic_jwt_secret_min_32_characters
JWT_EXPIRES_IN=7d

# CORS Whitelist (Frontend Domain)
CLIENT_URL=https://your-production-domain.com

# Ollama Engine / Local LLM Inference
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_MS=180000

# Rate Limiting Overrides (Optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REVIEWS=30
