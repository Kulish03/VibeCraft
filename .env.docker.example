# =================================================================
# VIBECRAFT Docker Environment Configuration (.env.docker.example)
# Copy to .env in project root to override default Docker values
# =================================================================

# Express Backend Port (Internal container: 5000)
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Inside docker network: mongodb service)
MONGODB_URI=mongodb://mongodb:27017/ai_code_reviewer

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secure_secret_for_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost

# Ollama Local Runtime Configuration
# NOTE: host.docker.internal allows container to reach Ollama on the host OS
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_MS=180000

# Frontend Host Port
FRONTEND_PORT=80
